# LunaAI Web backend configuration. Copy to .env and adjust. Never commit .env.

NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

DB_PATH=./data/lunaai-web.db

# Comma-separated browser origins allowed to call the API with credentials.
CORS_ORIGINS=

# AI provider. Without OPENAI_API_KEY the labelled development provider answers.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Server-side tools are off by default and can only ever be server-scoped.
ENABLE_SERVER_TOOLS=false
SERVER_TOOL_ALLOWLIST=
SERVER_TOOL_MAX_ROUNDS=3

# Abuse protection
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_WINDOW_MS=60000
