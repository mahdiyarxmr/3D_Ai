{
  "name": "hermes-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "HERMES — local-first desktop AI companion with a VRM avatar, voice, and permissioned computer use.",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @hermes/desktop",
    "dev:tauri": "npm run tauri:dev --workspace @hermes/desktop",
    "build": "npm run build --workspaces --if-present",
    "build:tauri": "npm run tauri:build --workspace @hermes/desktop",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --build --force",
    "services:agent": "python -m uvicorn services.agent.main:app --port 8731 --host 127.0.0.1",
    "services:voice": "python -m uvicorn services.voice.main:app --port 8732 --host 127.0.0.1",
    "services:vision": "python -m uvicorn services.vision.main:app --port 8733 --host 127.0.0.1",
    "services:joyai": "python -m uvicorn services.joyai.main:app --port 8734 --host 127.0.0.1",
    "test:py": "python -m pytest",
    "verify": "bash scripts/verify.sh"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
